---
interface Props {
  /** Text to display; each character becomes a flapping cell. */
  target: string
  /** Preset name (resolved by the hydrator). */
  preset?: string
  /** Milliseconds per flap. */
  durationPerFlap?: number
  /** Flip direction. */
  direction?: 'forward' | 'shortest'
  class?: string
}

const { target, preset, durationPerFlap, direction, class: className } = Astro.props
---

<span
  class:list={['ptpt', className]}
  data-ptpt-targets={target}
  data-ptpt-preset={preset}
  data-ptpt-duration={durationPerFlap}
  data-ptpt-direction={direction}>{target}</span>
