{
  "name": "@love-rox/ptpt-react",
  "version": "0.1.0",
  "description": "React wrapper for ptpt, the split-flap display library.",
  "keywords": [
    "flipboard",
    "patapata",
    "react",
    "split-flap"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Love-Rox/ptpt.git",
    "directory": "packages/ptpt-react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
